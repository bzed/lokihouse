{app=~".+"} |= "logging.go" | logfmt | line_format "{{.msg}}" | regexp "(?P<method>\\w+) (?P<path>[\\w|/]+) \\((?P<status>\\d+?)\\) (?P<duration>.*)" | ( ( duration>1s or status==200 ) , method="POST" ) | line_format "{{.duration}}|{{.method}}|{{.status}}"
{app=~".+"} |= "metrics.go" != "loki-canary" | logfmt | query!="" | label_format query="{{ Replace .query \"\\n\" \"\" -1 }}" | line_format "{{ .ts}}\t{{.duration}}\ttraceID = {{.traceID}}\t{{ printf \"%-100.100s\" .query }} "
{app=~".+"} |= "metrics.go" != "out of order" | logfmt | ( duration>30s or status_code!="200" )
{app=~".+"} |= "metrics.go" | logfmt | ( duration>10s , throughput_mb<500 )
{app=~".+"} |= "test"
{app=~".+"} |= ip("123.123.123.123")
{app=~".+"} |= ip("123.123.123.123") |= "baz"
{app=~".+"} |= ip("123.123.123.123") |= "baz" |= ip("123.123.123.123")
{app=~".+"} |= ip("192.168.4.5/16")
{app=~".+"} |> "<_> caller=http.go:194 level=debug <_> msg=\"POST /push.v1.PusherService/Push <_>"
{app=~".+"} |> "foo" or "bar" or "baz"
{app=~".+"} |~ "Invalid user.*" | regexp "(^(?P<user>\\S+ {1,2}){8})" | regexp "(^(?P<ip>\\S+ {1,2}){10})" | line_format "IP = {{.ip}}\tUSER = {{.user}}"
