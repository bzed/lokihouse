<!-- MergeTree tables on the RustFS bucket behind ClickHouse's local filesystem cache. -->
<clickhouse>
  <storage_configuration>
    <disks>
      <s3>
        <type>s3</type>
        <endpoint>http://lhb-rustfs:9000/clickhouse/s3cache/</endpoint>
        <access_key_id>rustfsadmin</access_key_id>
        <secret_access_key>rustfsadmin</secret_access_key>
      </s3>
      <s3_cache>
        <type>cache</type>
        <disk>s3</disk>
        <path>/var/lib/clickhouse/s3_cache/</path>
        <max_size>10Gi</max_size>
      </s3_cache>
    </disks>
    <policies>
      <s3><volumes><main><disk>s3_cache</disk></main></volumes></s3>
    </policies>
  </storage_configuration>
  <merge_tree><storage_policy>s3</storage_policy></merge_tree>
</clickhouse>
